# Copy to server/.env for local development. Never commit .env or real credentials.
# On Render, set these in the service's Environment tab instead.

# --- Used since Phase 1 ---
NODE_ENV=development
PORT=5000
# Browser origin(s) allowed by CORS. Comma-separate multiple. Must be https in production.
# Use the exact origin of the deployed frontend: scheme and host only, no path, e.g.
# https://leadsync-crm.onrender.com. Any other origin is refused (and so are cookie requests).
FRONTEND_URL=http://localhost:5173
# Optional: fatal | error | warn | info | debug | trace | silent (default: info, silent in test)
LOG_LEVEL=
# Optional: number of reverse-proxy hops to trust (default: 0, or 1 in production for Render)
TRUST_PROXY=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Phase 2: database and authentication ---
# Required. Atlas example: mongodb+srv://<user>:<password>@<cluster-host>/leadsync?retryWrites=true&w=majority
# Keep the real value only in your local .env or Render's environment settings.
MONGODB_URI=
# Required, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Password hashing cost. Must be at least 10 in production.
BCRYPT_ROUNDS=12
# lax | strict | none. Defaults to lax, and to none (with Secure) in production.
REFRESH_COOKIE_SAMESITE=
# Failed sign-ins per 15 minutes, and registrations per hour, per IP.
AUTH_RATE_LIMIT_MAX=20

# --- Phase 6: lead retrieval ---
# Facebook requests per form in one sync run (each returns up to 100 leads). A form with more
# leads than that continues on the next sync.
LEAD_SYNC_MAX_REQUESTS_PER_FORM=10

# --- Phase 4: Meta OAuth (Facebook Login for Business) ---
# All-or-nothing: set every META_* value and TOKEN_ENCRYPTION_KEY, or none of them (Facebook login
# is then switched off). All are required in production. See docs/META_SETUP.md.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
# Configuration ID from App Dashboard > Facebook Login for Business > Configurations
META_LOGIN_CONFIG_ID=
# Public URL of the backend callback, e.g. https://<api-host>/api/v1/facebook/oauth/callback
META_OAUTH_REDIRECT_URI=
# Encrypts stored Meta tokens (AES-256-GCM). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Optional, for key rotation: retired keys (comma-separated) that can still decrypt old tokens.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# --- Phase 7: webhooks ---
# Part of the all-or-nothing Meta group above. Any random string of at least 16 characters; it must
# match the Verify Token entered in the Meta App Dashboard under Webhooks.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
META_WEBHOOK_VERIFY_TOKEN=
# How often the background worker looks for new-lead events to process (milliseconds). New events
# also wake it immediately, so this mostly matters for retries.
WEBHOOK_WORKER_INTERVAL_MS=10000
